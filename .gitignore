# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# xcodebuild's products in a CI job
/.derived-data/

# fastlane and its gems (the example's delivery to Hangar)
/.bundle/
/vendor/
/fastlane/report.xml
/fastlane/README.md

# The Yolla Voice Android SDK built from a checkout of its sources (tool/build-android-sdk.sh).
/.local-maven/

# Gradle files of the plugin opened on its own
/android/.gradle/
/android/local.properties

# CI: the Flutter SDK of tool/flutter-version and the native SDKs checked out for a job
/.flutter-sdk/
/.native-sdk/
/public-package/
